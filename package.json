{
  "name": "dsh-canvas",
  "version": "1.0.1",
  "description": "无限画布设计工作台：9 个 dsh_canvas_* 工具、dsh-canvas 技能、主面板画布与 /design 设计模式",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <27"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs",
    "skills",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build": "node scripts/build.mjs",
    "notices": "node scripts/gen-third-party.mjs",
    "notices:check": "node scripts/gen-third-party.mjs --check",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.mjs\"",
    "verify": "npm run typecheck && npm run build && npm run notices && npm test",
    "verify:codegen": "node scripts/verify-codegen.mjs",
    "verify:codegen:real": "node scripts/verify-codegen-real.mjs",
    "verify:prototypes": "node scripts/verify-prototypes.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@xyflow/react": "^12.3.5",
    "esbuild": "^0.25.12",
    "json-canonicalize": "^1.2.0",
    "puppeteer-core": "^25.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.6",
    "typescript": "^5.6.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  }
}
